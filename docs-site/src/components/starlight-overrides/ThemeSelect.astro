---
// Full replacement of Starlight's default 3-way (dark/light/auto) <select>
// picker with the same two-state "M-x bloom-<label>-theme" pill used on the
// landing page, wired to the same shared theme state.
import '../../styles/theme-pill.css';
---

<button type="button" class="bloom-theme-pill" data-bloom-theme-toggle>
  M-x <span class="bloom-theme-pill__label" data-bloom-theme-label>bloom-dark-theme</span>
</button>

<script>
  import { wireThemeTogglePills } from '../../scripts/theme-toggle.js';

  wireThemeTogglePills();
</script>
